{
  "name": "@cupya.me/arcade-at-live",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "release": "COMMIT_SHA=$(git rev-parse --short HEAD) pnpm run build && wrangler deploy",
    "dev": "react-router dev",
    "postinstall": "npm run cf-typegen",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply arcade-at-live-local --local",
    "migrate:remote": "wrangler d1 migrations apply cupya-me --remote --env production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@cupya.me/db": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "isbot": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cupya.me/eslint-config": "workspace:*",
    "@cupya.me/typescript-config": "workspace:*",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
