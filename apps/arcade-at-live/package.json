{
  "name": "@cupya.me/arcade-at-live",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "react-router dev",
    "postinstall": "npm run cf-typegen",
    "preview": "pnpm run build && vite preview",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply arcade-at-live-local --local",
    "migrate:remote": "wrangler d1 migrations apply cupya-me --remote",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
  "@cupya.me/db": "workspace:*",
  "drizzle-orm": "catalog:",
  "isbot": "catalog:",
  "react": "catalog:",
  "react-dom": "catalog:",
  "react-router": "catalog:"
},
"devDependencies": {
  "@cloudflare/vite-plugin": "catalog:",
  "@cupya.me/eslint-config": "workspace:*",
  "@cupya.me/typescript-config": "workspace:*",
  "@react-router/dev": "catalog:",
  "@tailwindcss/vite": "catalog:",
  "@types/node": "catalog:",
  "@types/react": "catalog:",
  "@types/react-dom": "catalog:",
  "drizzle-kit": "catalog:",
  "eslint": "catalog:",
  "tailwindcss": "catalog:",
  "typescript": "catalog:",
  "vite": "catalog:",
  "vite-tsconfig-paths": "catalog:",
  "wrangler": "catalog:"
}
}